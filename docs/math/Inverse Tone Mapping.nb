Cell[CellGroupData[{

Cell["Operators", "Subtitle",
 CellChangeTimes->{{3.6472069892556753`*^9, 3.647206992644547*^9}, {
  3.64720706386841*^9, 3.64720723066249*^9}, {3.647207262730607*^9, 
  3.647207325235694*^9}, {3.661121273814883*^9, 3.6611212811271257`*^9}, {
  3.6611836316553793`*^9, 3.661183634470564*^9}, {3.6815771809416018`*^9, 
  3.681577182173439*^9}, {3.736009556608379*^9, 3.736009615808835*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Unreal", " ", "Engine"}], ",", " ", 
    RowBox[{"modified", " ", "to", " ", "match", " ", "ACES"}]}], " ", "*)"}],
   "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"unrealOp", "[", 
     RowBox[{"x_", ",", "offset_", ",", "scale_"}], "]"}], " ", ":=", " ", 
    RowBox[{
     RowBox[{"x", " ", "/", " ", 
      RowBox[{"(", 
       RowBox[{"x", " ", "+", " ", "offset"}], ")"}]}], " ", "*", " ", 
     "scale"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"unreal", "[", "x_", "]"}], " ", ":=", " ", 
    RowBox[{"unrealOp", "[", 
     RowBox[{"x", ",", " ", "0.155", ",", "1.019"}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"inverseUnreal", "[", "x_", "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "0.155"}], "*", "x"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"x", " ", "-", " ", "1.019"}], ")"}]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"inverseUnrealLinearInput", "[", "x_", "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "0.155"}], "*", 
       RowBox[{"x", "^", 
        RowBox[{"(", 
         RowBox[{"1", "/", "2.2"}], ")"}]}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"x", "^", 
        RowBox[{"(", 
         RowBox[{"1", "/", "2.2"}], ")"}]}], " ", "-", " ", "1.019"}], 
      ")"}]}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"ACES", " ", "operator"}], ",", " ", 
     RowBox[{"for", " ", "LDR", " ", "and", " ", "HDR"}]}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ACESop", "[", 
     RowBox[{
     "x_", ",", "a_", ",", " ", "b_", ",", " ", "c_", ",", " ", "d_", ",", 
      " ", "e_"}], "]"}], ":=", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"x", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"a", "*", "x"}], "+", "b"}], ")"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"x", "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"c", "*", "x"}], "+", "d"}], ")"}]}], "+", "e"}], ")"}]}]}],
    "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"ACES", " ", "sRGB"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"linearACES", "[", "x_", "]"}], " ", ":=", " ", 
    RowBox[{"Clip", "[", 
     RowBox[{
      RowBox[{"ACESop", "[", 
       RowBox[{
       "x", ",", " ", "2.51", ",", " ", "0.03", ",", " ", "2.43", ",", " ", 
        "0.59", ",", " ", "0.14"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ACES", "[", "x_", "]"}], ":=", 
    RowBox[{
     RowBox[{"linearACES", "[", "x", "]"}], "^", 
     RowBox[{"(", 
      RowBox[{"1", "/", "2.2"}], ")"}]}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"identityUnreal", "[", "x_", "]"}], "=", 
     RowBox[{"unreal", "[", 
      RowBox[{"inverseUnreal", "[", "x", "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"identityUnrealLinearInput", "[", "x_", "]"}], "=", 
     RowBox[{"unreal", "[", 
